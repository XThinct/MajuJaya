{
  "name": "maju-jaya-approvals",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:import": "npm run db:import -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
